{
  "buildCommand": "npx prisma generate && npx next build --webpack",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "nodeVersion": "22.21.1",
  "cloudFunctions": {
    "regions": {
      "overseas": ["ap-singapore"]
    },
    "externalNodeModules": [
      "@prisma/client",
      "@prisma/adapter-pg",
      "pg"
    ],
    "maxDuration": 60
  }
}
