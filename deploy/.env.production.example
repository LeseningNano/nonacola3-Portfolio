# 生产环境变量模板 — 复制到服务器上项目根目录的 .env 并填入真实值
# chmod 600 .env，切勿提交到仓库。

# ── 数据库 ─────────────────────────────────────────────
# 短期继续用 Neon（香港服务器 → 新加坡区延迟低），无需迁移。
# 注意：npm run build 会执行 prisma migrate deploy，确认这里指向的是
# 正确的库（当前生产库），避免误迁移到空库/错误库。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ── 管理后台账号（与现有生产一致）──────────────────────
ADMIN_USERNAME="..."
ADMIN_PASSWORD="..."

# ── next-auth（自托管必改）─────────────────────────────
# 密钥生成：openssl rand -base64 32
# 服务器上同时提供新旧两个变量名，兼容 next-auth v5 beta 的读取顺序
NEXTAUTH_SECRET="..."
AUTH_SECRET="..."
# 非平台托管环境必须显式信任主机，否则登录报 UntrustedHost
AUTH_TRUST_HOST="true"
# 建议显式声明生产地址，避免反向代理下回调地址推断错误
AUTH_URL="https://your-domain.com"

# ── Vercel Blob（短期保留：封面上传仍走 Blob）──────────
BLOB_READ_WRITE_TOKEN="..."
