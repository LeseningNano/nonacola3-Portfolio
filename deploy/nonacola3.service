# systemd 服务模板 — nonacola3 Portfolio
# 部署路径：/etc/systemd/system/nonacola3.service
# 前提：Node 通过 NodeSource apt 安装（npm 位于 /usr/bin/npm）；
#       代码位于 /opt/nonacola3；环境变量写在 /opt/nonacola3/.env（next start 自动加载）。

[Unit]
Description=nonacola3 portfolio (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nonacola3
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# 2C2G 机型上限制 Node 堆，给系统留余量
Environment=NODE_OPTIONS=--max-old-space-size=1024

[Install]
WantedBy=multi-user.target
